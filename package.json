{
  "name": "book-walker-marker-plus",
  "displayName": "Book Walker Marker Plus",
  "version": "0.1.1",
  "description": "A Chrome extension for portable Book Walker highlights, notes and passage-scoped LLM chat.",
  "author": "danny",
  "license": "AGPL-3.0-only",
  "private": true,
  "keywords": [
    "bookwalker",
    "browser-extension",
    "chrome-extension",
    "highlights",
    "plasmo"
  ],
  "packageManager": "pnpm@11.1.1",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "node scripts/prepare-package.mjs && plasmo package",
    "verify:package": "node scripts/verify-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.44",
    "@ai-sdk/openai": "4.0.41",
    "@ai-sdk/provider-utils": "5.0.27",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "@plasmohq/messaging": "0.7.2",
    "ai": "7.0.65",
    "idb": "8.0.3",
    "marked": "18.0.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/chrome": "0.2.5",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "autoprefixer": "^10.5.4",
    "fake-indexeddb": "^6.2.5",
    "postcss": "^8.5.26",
    "plasmo": "0.90.5",
    "tailwindcss": "^4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "manifest": {
    "default_locale": "en",
    "name": "__MSG_extensionName__",
    "description": "__MSG_extensionDescription__",
    "permissions": [
      "sidePanel",
      "storage",
      "unlimitedStorage"
    ],
    "host_permissions": [
      "https://viewer.bookwalker.jp/*",
      "https://api.notion.com/*"
    ],
    "optional_host_permissions": [
      "https://openrouter.ai/*",
      "https://api.openai.com/*",
      "https://generativelanguage.googleapis.com/*",
      "https://*/*"
    ]
  }
}
