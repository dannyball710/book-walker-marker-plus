{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [
      "chrome",
      "vitest/globals"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "~/*": [
        "./src/*"
      ]
    }
  },
  // ".plasmo/index.d.ts" is listed only so `plasmo build` stops rewriting this file; the
  // exclude below cancels it, so the generated types never load and src/messaging.d.ts
  // remains the single source of message names. Removing either half hands the config
  // back to Plasmo to rewrite on every build.
  "include": [
    ".plasmo/index.d.ts",
    "src",
    "tests",
    "*.ts",
    "*.config.ts"
  ],
  "exclude": [
    "node_modules",
    ".plasmo",
    "build"
  ]
}
